# Managed by Ansible - role zot_registry
# IDrive e2 (S3) and environment credentials

{% if zot_s3_enabled %}
{% if zot_s3_access_key | length > 0 %}
AWS_ACCESS_KEY_ID={{ zot_s3_access_key }}
{% endif %}
{% if zot_s3_secret_key | length > 0 %}
AWS_SECRET_ACCESS_KEY={{ zot_s3_secret_key }}
{% endif %}
{% if zot_s3_region | length > 0 %}
AWS_REGION={{ zot_s3_region }}
{% endif %}
{% endif %}

{% for key, val in zot_custom_env.items() %}
{{ key }}={{ val }}
{% endfor %}
